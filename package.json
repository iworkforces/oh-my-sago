  "repository": {
    "type": "git",
    "url": "git+https://github.com/iworkforces/oh-my-sago.git"
  },
  "files": [
    "dist",
    "scripts/postinstall.mjs",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "scripts": {
    "postinstall": "node ./scripts/postinstall.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint --type-aware --deny-warnings",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.19.6",
    "@opencode/plugin": "2.3.0",
    "oh-my-openagent": "5.1.75",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.38",
    "@opencode-ai/plugin": "1.19.6",
    "@opencode/ai": "2.3.0",
    "@opencode/cli": "2.3.0",
    "@opencode/schema": "2.3.0",
    "@opencode/sdk": "2.3.0",
    "@tsconfig/node26": "26.0.2",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "effect": "4.1.4",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "6.0.2"
  },
  "peerDependencies": {
    "effect": "4.1.0"
  },
  "packageManager": "bun@1.4.4"
}
