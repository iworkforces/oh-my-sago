{
  "name": "omsg",
  "version": "1.0.0",
  "description": "It codes like a SWEE would, another lobster way 🦞",
  "keywords": [
    "coding-agent",
    "omo",
    "omsg",
    "opencode",
    "typescript"
  ],
  "homepage": "https://github.com/iworkforces/oh-my-sago#readme",
  "bugs": {
    "url": "https://github.com/iworkforces/oh-my-sago/issues"
